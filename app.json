{
  "expo": {
    "name": "動画保存",
    "slug": "video-saver",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "videosaver",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.nekocracker.moviedl",
      "supportsTablet": false,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "audio",
          "processing"
        ],
        "NSPhotoLibraryAddUsageDescription": "保存した動画を写真アプリにコピーするために使用します。",
        "NSFaceIDUsageDescription": "アプリやフォルダのロック解除に使用します。",
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.nekocracker.moviedl.convert.*"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "動画",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.movie",
              "public.mpeg-4",
              "com.apple.quicktime-movie",
              "public.mpeg-2-transport-stream",
              "public.avi",
              "org.webmproject.webm",
              "org.matroska.mkv"
            ]
          },
          {
            "CFBundleTypeName": "音声",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.audio",
              "public.mp3",
              "com.apple.m4a-audio"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "org.webmproject.webm",
            "UTTypeDescription": "WebM",
            "UTTypeConformsTo": [
              "public.movie"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "webm"
              ],
              "public.mime-type": [
                "video/webm"
              ]
            }
          },
          {
            "UTTypeIdentifier": "org.matroska.mkv",
            "UTTypeDescription": "Matroska",
            "UTTypeConformsTo": [
              "public.movie"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "mkv"
              ],
              "public.mime-type": [
                "video/x-matroska"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "保存した動画を写真アプリにコピーするために使用します。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "カメラロールの動画や写真をフォルダに追加するために使用します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "許可すると、あなたに合った広告が表示されやすくなります。許可しなくても、すべての機能を使えます。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "許可すると、あなたに合った広告が表示されやすくなります。許可しなくても、すべての機能を使えます。",
